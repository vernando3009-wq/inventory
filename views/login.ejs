<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login – Inventory Stock System</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .login-wrapper {
      min-height: 80vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1rem;
    }
    .login-box {
      background: #ffffff;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      width: 100%;
      max-width: 420px;
      padding: 2.2rem 2rem;
      border-top: 5px solid #1e5f8a;
    }
    .login-logo {
      text-align: center;
      margin-bottom: 1.5rem;
    }
    .login-logo img {
      max-height: 55px;
      margin-bottom: 0.5rem;
    }
    .login-logo h2 {
      margin: 0;
      color: #1e5f8a;
      font-size: 1.4rem;
    }
    .login-logo p {
      margin: 0.25rem 0 0 0;
      color: #666;
      font-size: 0.85rem;
    }
    .login-box .form-group {
      margin-bottom: 1.2rem;
    }
    .login-box label {
      display: block;
      margin-bottom: 0.35rem;
      font-weight: 600;
      color: #333;
      font-size: 0.9rem;
    }
    .login-box input[type="text"],
    .login-box input[type="password"] {
      width: 100%;
      padding: 0.7rem 0.85rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 0.95rem;
      box-sizing: border-box;
      transition: border-color 0.2s;
    }
    .login-box input[type="text"]:focus,
    .login-box input[type="password"]:focus {
      outline: none;
      border-color: #1e5f8a;
      box-shadow: 0 0 0 3px rgba(30, 95, 138, 0.15);
    }
    .login-btn {
      width: 100%;
      padding: 0.75rem;
      background: #1e5f8a;
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }
    .login-btn:hover {
      background: #164869;
    }
    .credentials-hint {
      margin-top: 1.5rem;
      padding: 0.75rem;
      background: #f0f7fb;
      border-left: 3px solid #1e5f8a;
      border-radius: 3px;
      font-size: 0.82rem;
      color: #444;
    }
    .credentials-hint code {
      background: #e2eef6;
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      font-weight: bold;
      color: #164869;
    }
  </style>
</head>
<body style="background: #eaf2f8;">
  <div class="login-wrapper">
    <div class="login-box">
      <div class="login-logo">
        <img src="/logo.png" alt="Logo">
        <h2>Inventory System</h2>
        <p>Silakan masuk ke akun Anda</p>
      </div>

      <% if (error) { %>
        <div class="alert-error" style="margin-bottom: 1.2rem;">
          <%= error %>
        </div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="username">Username:</label>
          <input type="text" id="username" name="username" placeholder="Masukkan username" required autofocus>
        </div>

        <div class="form-group">
          <label for="password">Password:</label>
          <input type="password" id="password" name="password" placeholder="Masukkan password" required>
        </div>

        <button type="submit" class="login-btn">Masuk ke Sistem</button>
      </form>

      <div class="credentials-hint">
        <strong>Akun Default:</strong><br>
        Username: <code>admin</code><br>
        Password: <code>admin123</code>
      </div>
    </div>
  </div>

  <footer>
    <div class="container">© 2026 Inventory Stock System</div>
  </footer>
</body>
</html>
