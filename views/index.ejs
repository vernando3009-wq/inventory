<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory Stock</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <nav class="container" style="display:flex; align-items:center; flex-wrap:wrap;">
      <a href="/" style="padding:0; margin-right:0.5rem; display:flex; align-items:center;">
        <img src="/logo.png" alt="Logo" class="logo" style="height:36px; vertical-align:middle;">
      </a>
      <a href="/" class="active">Home</a>
      <a href="/add">Add Item</a>
      <a href="/adjust">Stok Masuk/Keluar</a>
      <a href="/transactions">Riwayat Transaksi</a>
      <a href="/stats">Stats</a>
      <a href="/about">About</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <div style="margin-left:auto; display:flex; align-items:center; gap:0.6rem;">
          <span style="color:#ffffff; font-size:0.85rem;">👤 <strong><%= user.name %></strong></span>
          <a href="/logout" class="button small danger" style="padding:0.25rem 0.6rem; font-size:0.8rem; margin:0;">Logout</a>
        </div>
      <% } %>
    </nav>
  </header>
  <div class="container">
    <h1>Inventory Stock</h1>
    <form method="GET" action="/" class="search-form">
      <input type="text" name="q" placeholder="Search by name" value="<%= typeof query !== 'undefined' ? query : '' %>">
      <button type="submit" class="button small">Search</button>
      <a href="/" class="button small">Clear</a>
    </form>
    <a href="/add" class="button">Add New Item</a>
    <table>
      <thead>
        <tr><th>ID</th><th>Name</th><th>Quantity</th><th>Price</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% items.forEach(function(item){ %>
          <tr>
            <td><%= item.id %></td>
            <td><%= item.name %></td>
            <td><%= item.quantity %></td>
            <td><%= formatPrice(item.price, item.currency) %></td>
            <td>
              <a href="/adjust/<%= item.id %>" class="button small success" title="Stok Masuk / Keluar">+/- Stok</a>
              <a href="/edit/<%= item.id %>" class="button small">Edit</a>
              <form action="/delete/<%= item.id %>" method="POST" style="display:inline;">
                <button type="submit" class="button small danger" onclick="return confirm('Delete this item?');">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
